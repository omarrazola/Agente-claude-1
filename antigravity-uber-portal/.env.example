# Puerto del backend
PORT=3001

# Google AI Studio API Key
# Consigue tu clave en https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Atlassian Jira Cloud REST API
# Ejemplo: pruebascluadegdi.atlassian.net
JIRA_HOST=pruebascluadegdi.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Firebase Firestore (Opcional - si no se suministran, el portal funciona con IndexedDB localmente)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
